{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "university_key": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "full_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "\\S"
        },
        "email": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "cpf": {
            "type": "string",
            "pattern": "^[0-9]{11}$"
        },
        "birthdate": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
    },
    "required": [
        "university_key",
        "full_name",
        "email",
        "cpf",
        "birthdate"
    ],
    "additionalProperties": false
}
