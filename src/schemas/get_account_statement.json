{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "limit": {
            "type": "string",
            "pattern": "^([1-9]|[1-9][0-9]|100)$"
        },
        "page": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,5})$"
        }
    },
    "additionalProperties": false
}
