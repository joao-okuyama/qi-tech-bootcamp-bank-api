{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "members": {
            "type": "array",
            "minItems": 2,
            "maxItems": 100,
            "items": {
                "type": "object",
                "properties": {
                    "customer_key": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    },
                    "role": {
                        "enum": [
                            "MEMBRO",
                            "TESOUREIRO",
                            "PRESIDENTE",
                            "VICE_PRESIDENTE"
                        ]
                    }
                },
                "required": [
                    "customer_key",
                    "role"
                ],
                "additionalProperties": false
            }
        },
        "approvers": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
        }
    },
    "required": [
        "members",
        "approvers"
    ],
    "additionalProperties": false
}
