{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "university_key": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "legal_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "\\S"
        },
        "trade_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "\\S"
        },
        "email": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "cnpj": {
            "type": "string",
            "pattern": "^[A-Z0-9]{12}[0-9]{2}$"
        }
    },
    "required": [
        "university_key",
        "legal_name",
        "trade_name",
        "email",
        "cnpj"
    ],
    "additionalProperties": false
}
